# Copy to .env.local. This is an ingestion-only project token (phc_), not a personal API key.
VITE_POSTHOG_PROJECT_TOKEN=
# Exactly one of https://us.i.posthog.com or https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Optional kill switch. Rebuild/reload after changing any value.
VITE_POSTHOG_ENABLED=true
