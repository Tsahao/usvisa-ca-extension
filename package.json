{
  "name": "usvisa-ca-extension",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test:browser": "npm run build:test && playwright test",
    "build:test": "node scripts/build.mjs --mode test --outDir dist-test",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "check": "npm test && npm run test:packaging && npm run build && npm run smoke:release",
    "test:packaging": "node --test scripts/packaging.test.mjs",
    "smoke:release": "node scripts/release-smoke.mjs",
    "package:release": "node scripts/package-release.mjs",
    "package:source": "node scripts/package-source.mjs",
    "prepare:public": "node scripts/prepare-public.mjs",
    "build:privacy": "node scripts/build-privacy.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
